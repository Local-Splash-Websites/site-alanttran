# Copy to .env and fill in. scripts/setup-server.sh and scripts/deploy.sh read this file.
# Never commit your real .env.

# --- Website / Apache ---
SITE_DOMAIN=alantran-plastic-surgery.com          # main domain (DNS A record must point at this server)
SITE_ALIASES=www.alantran-plastic-surgery.com     # extra hostnames, space-separated (or leave blank)
ADMIN_EMAIL=you@example.com                       # Apache ServerAdmin + Let's Encrypt expiry notices
DOCROOT=/var/www/alantran                         # where the built site is published
ENABLE_HTTPS=true                                 # true = get a free Let's Encrypt certificate with certbot

# --- Contact form (contact.php) ---
SITE_NAME="Alan T. Tran, M.D."                    # shown in the email subject/From name
CONTACT_TO_EMAIL=office@alantranmd.com            # where form submissions are delivered
MAIL_FROM=website@alantran-plastic-surgery.com    # From address; must be allowed by your SMTP provider

# --- Outgoing mail (SMTP relay used by msmtp) ---
# Any SMTP provider works: Google Workspace, Microsoft 365, SendGrid, Mailgun, Amazon SES, Postmark...
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=on                                       # on for 587/465; set SMTP_STARTTLS=off for port 465
SMTP_STARTTLS=on
