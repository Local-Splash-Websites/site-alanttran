# Coolify deployment: add these as application Environment Variables.
# Safe defaults are in docker-compose.yml. No real .env file is required.
# Mark SMTP_PASS as secret in Coolify; never commit actual credentials.
SITE_DOMAIN=alanttran.site.localsplash.ai
SITE_NAME=Alan T. Tran, M.D.
CONTACT_TO_EMAIL=office@alantranmd.com
MAIL_FROM=website@localsplash.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=on
SMTP_STARTTLS=on

# Legacy bare-metal Apache scripts only (not used by Coolify/Compose).
SITE_ALIASES=
ADMIN_EMAIL=systems@localsplash.com
DOCROOT=/var/www/alantran
ENABLE_HTTPS=false
